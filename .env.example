# SquadLogic — Environment Variables Template
# Copy this file to .env and fill in your values.
# See .env.local.example for secrets that must NOT be committed.
# ------------------------------------------------------------

# ── Supabase project URL (safe to commit) ────────────────────
VITE_SUPABASE_URL=your_supabase_project_url

# ── Publishable key (safe to commit) ─────────────────────────
# Use the PUBLISHABLE key from Supabase → Settings → API.
# This key enforces Row Level Security and is safe to ship in
# the browser bundle.  Never put the Secret key here.
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# ── Observability (Phase 9 — optional, free tiers) ───────────
# Sentry DSN for frontend error tracking.
# Get yours at https://sentry.io → Create Project → Browser JavaScript.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# BetterStack (Logtail) source token for Edge Function logging.
# Get yours at https://logs.betterstack.com → Sources → Create Source.
# Set this in Supabase Dashboard → Edge Functions → Environment Variables.
# BETTERSTACK_SOURCE_TOKEN=your_betterstack_source_token

# ── Test credentials (used by E2E/Playwright in CI) ──────────
# See .env.test.example for the full test credentials template.
