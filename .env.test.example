# Test-only credentials template.
# Copy to .env.test and fill in your values.
#
# WARNING: Vite inlines any variable prefixed VITE_* into the client bundle.
# These keys are intentionally test-only; do NOT put real credentials here.
# CI / production builds must NEVER consume .env.test — only .env.production.
# Wave 7a/9a follow-up: rename to non-VITE_ prefix once test runners are
# updated to read from process.env at the Node layer instead of import.meta.env.
VITE_TEST_ADMIN_EMAIL=admin@example.com
VITE_TEST_COACH_EMAIL=coach@example.com
VITE_TEST_PASSWORD=your-test-password-here
