# SquadLogic — Local Developer Overrides Template
# Copy this file to .env.local (gitignored — never commit it).
# These values override .env for local development only.
# ------------------------------------------------------------

# ── Enable mock Supabase client for local dev / offline work ─
# Remove or set to false when testing against the real backend.
VITE_USE_MOCK_SUPABASE=true

# ── Secret key (SERVER-SIDE ONLY — never expose to the browser)
# Use the SECRET key from Supabase → Settings → API.
# Required by:
#   • scripts/verify_security_e2e.js
#   • scripts/verify_supabase_insert.js
#   • tests/e2e/steps/auth_setup.ts (real-backend E2E runs only)
# Edge Functions receive this key automatically from the
# Supabase runtime — you do NOT set it here for Edge Functions.
# NEVER prefix this with VITE_ (that would bundle it in the browser).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key
