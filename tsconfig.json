{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "strict": false,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["node", "react", "react-dom"]
  },
  "include": ["packages/core/src/**/*", "frontend/src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "frontend/dist"]
}
